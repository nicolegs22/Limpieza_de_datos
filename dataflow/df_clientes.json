{
	"name": "df_clientes",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "clientes_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          cliente_id as string,",
				"          nombre as string,",
				"          email as string,",
				"          telefono as string,",
				"          ciudad as string,",
				"          fecha_registro as string,",
				"          segmento as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(nombre = initCap(lower(trim(nombre))),",
				"          ciudad = case(",
				"    upper(trim(ciudad)) == 'SCZ', 'Santa Cruz',",
				"    upper(trim(ciudad)) == 'LPZ', 'La Paz',",
				"    upper(trim(ciudad)) == 'CBB', 'Cochabamba',",
				"    upper(trim(ciudad)) == 'ORU', 'Oruro',",
				"    upper(trim(ciudad)) == 'PTS', 'Potosí',",
				"    upper(trim(ciudad)) == 'CHU', 'Sucre',",
				"    upper(trim(ciudad)) == 'TJA', 'Tarija',",
				"    upper(trim(ciudad)) == 'BEN', 'Trinidad',",
				"    upper(trim(ciudad)) == 'PAN', 'Cobija',",
				"    trim(upper(ciudad))",
				"),",
				"          email = lower(trim(email))) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(cliente_id) && !isNull(nombre) && !isNull(email) && email!= '' && !isNull(telefono) ,",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos aggregate(groupBy(cliente_id),",
				"     nombre = first(nombre),",
				"          ciudad = first(ciudad),",
				"          email = first(email),",
				"          segmento = first(segmento),",
				"          telefono = first(telefono),",
				"          fecha_registro = first(fecha_registro)) ~> aggregate1"
			]
		}
	}
}