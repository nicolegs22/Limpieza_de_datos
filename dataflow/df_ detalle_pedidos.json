{
	"name": "df_ detalle_pedidos",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "detalle_pedidos_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          detalle_id as string,",
				"          pedido_id as string,",
				"          producto_id as string,",
				"          cantidad as string,",
				"          precio_unitario as string,",
				"          descuento_linea as string,",
				"          total_linea as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(cantidad = lower(trim(cantidad)),",
				"          precio_unitario = replace(replace(trim(precio_unitario),'Bs',''),',','.'),",
				"          descuento_linea = lower(trim(descuento_linea))) ~> derivedColumn1",
				"derivedColumn1 split(!isInteger(cantidad) || !isDecimal(precio_unitario) ||  !isDecimal(descuento_linea) || !isDecimal(total_linea) || toDecimal(descuento_linea) < 0 || toDecimal(descuento_linea)>100,",
				"     disjoint: false) ~> split1@(rechazados, aceptado)",
				"split1@rechazados derive(cantidad = toInteger(cantidad),",
				"          precio_unitario = ERROR_FUNCTION('')) ~> derivedColumn2"
			]
		}
	}
}